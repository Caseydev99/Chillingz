rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == "active";
    }

    function isNotificationRecipient() {
      return request.auth != null
        && (
          isGlobalNotification()
          ||
          resource.data.userId == request.auth.uid
          || resource.data.uid == request.auth.uid
          || resource.data.authUid == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
          || resource.data.targetUserId == request.auth.uid
          || (
            resource.data.recipients is list
            && request.auth.uid in resource.data.recipients
          )
        );
    }

    function isGlobalNotification() {
      return request.auth != null
        && (
          resource.data.audience in [
            "All users",
            "all users",
            "all",
            "all-users",
            "all_users",
            "everyone",
            "Everyone",
            "New",
            "new",
            "New users",
            "new users",
            "new-users",
            "new_users"
          ]
          || resource.data.targetAudience in [
            "All users",
            "all users",
            "all",
            "all-users",
            "all_users",
            "everyone",
            "Everyone",
            "New",
            "new",
            "New users",
            "new users",
            "new-users",
            "new_users"
          ]
          || resource.data.audienceType in [
            "All users",
            "all users",
            "all",
            "all-users",
            "all_users",
            "everyone",
            "Everyone",
            "New",
            "new",
            "New users",
            "new users",
            "new-users",
            "new_users"
          ]
        );
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isNotificationRecipient();
      allow write: if isAdmin();
    }

    // Messages from the website's contact form and gift voucher requests.
    // Anyone may send one; only admins can read them.
    match /enquiries/{enquiryId} {
      function isValidEnquiry() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'topic', 'name', 'email', 'phone', 'message', 'details', 'userId',
            'source', 'createdAt'
          ])
          && data.topic in ['general', 'vouchers', 'list-venue', 'press', 'privacy']
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && data.email.size() <= 200
          && data.phone is string && data.phone.size() <= 30
          && data.message is string && data.message.size() > 0 && data.message.size() <= 3000
          && data.details is map && data.details.size() <= 10
          && (data.userId == null || (request.auth != null && data.userId == request.auth.uid))
          && data.source == 'web'
          && data.createdAt == request.time;
      }

      allow create: if isValidEnquiry();
      allow read, update, delete: if isAdmin();
    }

    // "Sign up for updates and newsletters" from the website footer.
    // Anyone may sign up (with a tick-box consent); only admins can read
    // the list, e.g. to export it to the email platform.
    match /newsletterSignups/{signupId} {
      function isValidSignup() {
        let data = request.resource.data;
        return data.keys().hasOnly(['email', 'name', 'lists', 'consent', 'page', 'userId', 'source', 'createdAt'])
          && data.email is string && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && data.email.size() <= 200
          && data.name is string && data.name.size() <= 100
          && data.lists is list && data.lists.size() >= 1 && data.lists.size() <= 2
          && data.lists.hasOnly(['updates', 'newsletter'])
          && data.consent == true
          && data.page is string && data.page.size() <= 200
          && (data.userId == null || (request.auth != null && data.userId == request.auth.uid))
          && data.source == 'web'
          && data.createdAt == request.time;
      }

      allow create: if isValidSignup();
      allow read, update, delete: if isAdmin();
    }

    match /categories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chillingz/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ChillingzForYouContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /genres/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategoriesContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /listingCategories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userActivity/{documentId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /venues/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
