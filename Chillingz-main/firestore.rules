rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == "active";
    }

    function isNotificationRecipient() {
      return request.auth != null
        && (
          isGlobalNotification()
          ||
          resource.data.userId == request.auth.uid
          || resource.data.uid == request.auth.uid
          || resource.data.authUid == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
          || resource.data.targetUserId == request.auth.uid
          || (
            resource.data.recipients is list
            && request.auth.uid in resource.data.recipients
          )
        );
    }

    function isGlobalNotification() {
      return request.auth != null
        && (
          resource.data.audience in [
            "All users",
            "all users",
            "all",
            "all-users",
            "all_users",
            "everyone",
            "Everyone",
            "New",
            "new",
            "New users",
            "new users",
            "new-users",
            "new_users"
          ]
          || resource.data.targetAudience in [
            "All users",
            "all users",
            "all",
            "all-users",
            "all_users",
            "everyone",
            "Everyone",
            "New",
            "new",
            "New users",
            "new users",
            "new-users",
            "new_users"
          ]
          || resource.data.audienceType in [
            "All users",
            "all users",
            "all",
            "all-users",
            "all_users",
            "everyone",
            "Everyone",
            "New",
            "new",
            "New users",
            "new users",
            "new-users",
            "new_users"
          ]
        );
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isNotificationRecipient();
      allow write: if isAdmin();
    }

    match /categories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chillingz/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ChillingzForYouContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /genres/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategoriesContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /listingCategories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userActivity/{documentId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /venues/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
